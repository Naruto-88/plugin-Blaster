# Force Node.js Execution on LiteSpeed
Options +ExecCGI
AddHandler cloudlinux-nodejs-handler .js

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/divihdst/ns-app"
PassengerBaseURI "/"
PassengerNodejs "/home/divihdst/nodevenv/ns-app/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Simple Rewrite to handle routes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ server.js [QSA,L]