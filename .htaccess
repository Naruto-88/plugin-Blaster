# Force Phusion Passenger for Node.js
<Files app.js>
    SetHandler fastcgi-script
    ForceType application/x-httpd-php
</Files>

PassengerEnabled on
PassengerAppType node
PassengerStartupFile app.js
PassengerAppRoot /home/divihdst/pluginchecker.lowenet.biz

# Standard Rewrite for Node.js
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ app.js [QSA,L]
