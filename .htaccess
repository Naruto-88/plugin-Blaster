# Force Phusion Passenger for LiteSpeed/cPanel
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js
PassengerAppRoot /home/divihdst/pluginchecker.lowenet.biz

# LiteSpeed specific trigger for Passenger
RewriteEngine On
RewriteRule .* - [E=HTTP_PASSENGER_APP_TYPE:node]

# Standard Rewrite to ensure requests hit the app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ server.js [QSA,L]
