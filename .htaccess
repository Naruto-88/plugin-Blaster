# Standard Passenger Config
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js
PassengerAppRoot /home/divihdst/pluginchecker.lowenet.biz

# Ensure PHP/Apache doesn't try to handle .js files
AddHandler cgi-script .js
RemoveHandler .js

# Basic Rewrite to trigger the handler
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ server.js [QSA,L]
