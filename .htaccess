# Phusion Passenger setup
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js
PassengerAppRoot /home/divihdst/pluginchecker.lowenet.biz

# Ensure files are not treated as traditional scripts
Options -ExecCGI

# Rewrite all requests to server.js
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ server.js [QSA,L]
